# Copy to .env.local and fill in. Never commit real values.

# Production origin for canonical URLs, OG tags, robots.txt and sitemap.xml.
#
# Leave this empty. The live domain (https://www.ramblespins.com) is pinned in
# app/lib/request-origin.ts, and preview deploys use their own Vercel URL.
# Only set it if the domain changes and you need to override without a deploy.
SITE_URL=

# REQUIRED. Gamba affiliate standings, via the krush.gg affiliate API:
#   GET https://api.krush.gg/api/affiliate/wager-leader?startTimestamp=<unix>
#   X-API-Key: <this value>
# Server-only — it is never exposed to the browser. Without it the leaderboard
# renders its empty state rather than standings.
GAMBA_API_KEY=

# Optional overrides, both of which take priority over the Gamba feed above.
# Use them only if you need a different source.
#
# 1) A JSON endpoint returning [{ username, wagered }]. startDate/endDate query
#    params are appended automatically; the token is sent as a Bearer header:
LEADERBOARD_API_URL=
LEADERBOARD_API_TOKEN=
#
# 2) Or a published CSV (e.g. a Google Sheets "publish to web" link) with
#    username,wagered columns:
LEADERBOARD_CSV_URL=

# Set to 1 to render the placeholder roster for local design work.
# NEVER set this in production: it puts invented players on a live board.
SHOW_PLACEHOLDER_STANDINGS=

# The Kick channel is not configured here — it is a brand constant in
# app/data.ts (KICK_SLUG), since it also drives the public watch links.
