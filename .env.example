# Copy to .env.local and fill in. Never commit real values.

# Production origin for canonical URLs, OG tags, robots.txt and sitemap.xml.
#
# Leave this empty. The live domain (https://www.ramblespins.com) is pinned in
# app/lib/request-origin.ts, and preview deploys use their own Vercel URL.
# Only set it if the domain changes and you need to override without a deploy.
SITE_URL=

# Leaderboard data source — OPTIONAL.
#
# By default the site needs nothing here: it reads Dicey's own race page for
# /challenges/wager-race/<AFFILIATE_CODE> and pulls live standings plus
# per-player payouts from their API. See app/lib/dicey-race.ts.
#
# Set one of the following only to override that, e.g. if Dicey issues you a
# dedicated affiliate feed. The placeholder standings in leaderboards.ts appear
# only if the override AND the live race are both unreachable.
#
# 1) A published CSV (e.g. a Google Sheets "publish to web" link) with
#    username,points columns:
LEADERBOARD_CSV_URL=
#
# 2) Or a JSON endpoint returning [{ username, points }]. startDate/endDate
#    query params are appended automatically; the token is sent as a Bearer
#    header when set:
LEADERBOARD_API_URL=
LEADERBOARD_API_TOKEN=

# The Kick channel is not configured here — it is a brand constant in
# app/data.ts (KICK_SLUG), since it also drives the public watch links.
