# Copy to .env.local and fill in. Never commit real values.

# Production origin for canonical URLs, OG tags, robots.txt and sitemap.xml.
#
# Leave this empty. The live domain (https://www.ramblespins.com) is pinned in
# app/lib/request-origin.ts, and preview deploys use their own Vercel URL.
# Only set it if the domain changes and you need to override without a deploy.
SITE_URL=

# REQUIRED for the leaderboard. Maxxed's partner stats API key, sent as an
# X-API-Key header. Server-side only — never NEXT_PUBLIC_.
# See app/lib/maxxed-affiliate.ts.
MAXXED_API_KEY=

# Comma-separated usernames to leave off the board, exactly as Maxxed masks
# them (e.g. Ra***o). List the streamer's own account here.
MAXXED_EXCLUDE_USERNAMES=

# Optional overrides, which take priority over the partner's own feed.
# Use only if you need a different source.
#
# 1) A published CSV (e.g. a Google Sheets "publish to web" link) with
#    username,score columns:
LEADERBOARD_CSV_URL=
#
# 2) Or a JSON endpoint returning [{ username, points }] or [{ username,
#    wagered }]. startDate/endDate query params are appended automatically;
#    the token is sent as a Bearer header when set:
LEADERBOARD_API_URL=
LEADERBOARD_API_TOKEN=

# Set to 1 to render the placeholder roster for local design work.
# NEVER set this in production: it puts invented players on a live board.
SHOW_PLACEHOLDER_STANDINGS=

# The Kick channel is not configured here — it is a brand constant in
# app/data.ts (KICK_SLUG), since it also drives the public watch links.
